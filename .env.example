# =============================================================================
# Reliability Engineer — environment variables
# Copy to `.env` and fill in. Never commit real values.
# Variables marked [required in staging/production] are rejected at startup if left
# at their dev defaults when RE_ENV is staging or production.
# =============================================================================

# ---------------------------------------------------------------- general ----
RE_ENV=local                         # local | test | staging | production
RE_LOG_LEVEL=INFO
RE_API_BASE_URL=http://localhost:8000
RE_WEB_BASE_URL=http://localhost:3000
RE_CORS_ORIGINS=["http://localhost:3000"]

# --------------------------------------------------------------- postgres ----
# Three roles (scripts/db-bootstrap.sql): app (RLS enforced), system (BYPASSRLS for
# cross-tenant platform jobs), owner (migrations).
RE_DATABASE_URL=postgresql+psycopg://re_app:re_app@localhost:5432/reliability
RE_DATABASE_SYSTEM_URL=postgresql+psycopg://re_system:re_system@localhost:5432/reliability
RE_DATABASE_MIGRATION_URL=postgresql+psycopg://re_owner:re_owner@localhost:5432/reliability
RE_DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------ redis ----
RE_REDIS_URL=redis://localhost:6379/0
# RE_CELERY_BROKER_URL=                # defaults to RE_REDIS_URL

# --------------------------------------------------------- object storage ----
RE_OBJECT_STORE=local                # local | s3
RE_LOCAL_STORE_PATH=.local/artifacts
RE_S3_BUCKET=re-artifacts-local
RE_S3_REGION=us-east-1
# RE_S3_ENDPOINT_URL=http://localhost:9000   # MinIO locally; unset for AWS S3
# AWS_ACCESS_KEY_ID=                   # only for MinIO/local; use IAM roles in AWS
# AWS_SECRET_ACCESS_KEY=
RE_PRESIGN_TTL_SECONDS=900

# ------------------------------------------------- encryption of secrets ----
RE_KMS=local                         # local | aws   [aws required in staging/production]
# RE_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
RE_LOCAL_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=

# --------------------------------------------------------- signing keys ------
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RE_API_KEY_PEPPER=dev-pepper-change-me                                 # [required in staging/production]
RE_TOKEN_SIGNING_KEY=dev-token-signing-key-change-me-0123456789         # run/OTLP/share tokens [required]
RE_RUNNER_SIGNING_KEY=dev-runner-signing-key-change-me-0123456789       # runner identity tokens [required]

# ------------------------------------------------ identity provider (OIDC) ---
# Any OIDC provider issuing RS256 JWTs (Clerk recommended — docs/architecture/vendors.md).
# RE_IDP_ISSUER=https://your-instance.clerk.accounts.dev
# RE_IDP_AUDIENCE=reliability-api
# RE_IDP_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Dev sign-in ("Bearer dev:<email>") — only honoured when RE_ENV is local or test.
RE_DEV_AUTH_ENABLED=true             # [must be false in staging/production]

# ------------------------------------------------------------- GitHub App ----
# Create a GitHub App with permissions: contents R/W, pull_requests R/W, metadata R,
# deployments R (optional); webhook events: installation, installation_repositories,
# pull_request, push. Callback/setup URL: {RE_API_BASE_URL}/v1/integrations/github/callback
# RE_GITHUB_APP_ID=123456
# RE_GITHUB_APP_SLUG=reliability-engineer
# RE_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# RE_GITHUB_WEBHOOK_SECRET=
RE_GITHUB_API_URL=https://api.github.com

# ------------------------------------------------------------ LLM gateway ----
RE_LLM_PROVIDER=fake                 # anthropic | fake   [anthropic required in staging/production]
# RE_ANTHROPIC_API_KEY=sk-ant-...
RE_LLM_MODEL_TIER_S=claude-haiku-5-5
RE_LLM_MODEL_TIER_M=claude-sonnet-5-5
RE_LLM_MODEL_TIER_L=claude-opus-5-5
RE_LLM_TIMEOUT_SECONDS=180

# ------------------------------------------------------ telemetry (LGTM) -----
RE_MIMIR_URL=http://localhost:9009/prometheus
RE_TEMPO_URL=http://localhost:3200
RE_LOKI_URL=http://localhost:3100
RE_OTLP_PUBLIC_URL=http://localhost:4318

# -------------------------------------------------------- execution plane ----
RE_RUNNER_LEASE_TTL_SECONDS=15
RE_RUNNER_LONG_POLL_SECONDS=20
RE_EGRESS_IPS=[]                     # published egress IPs shown to customers, e.g. ["203.0.113.10"]

# ------------------------------------------------------------------ email ----
RE_EMAIL_PROVIDER=log                # log | ses
RE_EMAIL_FROM="Reliability Engineer <no-reply@localhost>"

# --------------------------------------------------------- error tracking ----
# RE_SENTRY_DSN=

# ============================================================ runner agent ===
# services/runner-agent (runs on execution-plane hosts)
RA_API_URL=http://localhost:8000
RA_RUNNER_ID=local-runner-1
# Runner identity token, issued by `reliability issue-runner-token --runner-id ...`
# (signed with RE_RUNNER_SIGNING_KEY). In production also behind mTLS/PrivateLink.
RA_RUNNER_TOKEN=
RA_DRIVER=process                    # process (local dev, no isolation) | docker (gVisor in production)
RA_DOCKER_RUNTIME=runsc              # gVisor runtime name for the docker driver
RA_SLOTS=4
RA_WORKDIR=.local/runner
RA_K6_BINARY=k6
RA_PLAYWRIGHT_COMMAND=npx playwright
# RA_EGRESS_PROXY_URL=http://egress-proxy.internal:3128

# ============================================================== web (Next) ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev            # dev | oidc
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
