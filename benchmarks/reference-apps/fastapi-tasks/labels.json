{
  "app": "fastapi-tasks",
  "framework": "fastapi",
  "routes": [
    "GET /health", "GET /api/projects", "GET /api/projects/{project_id}/tasks", "GET /api/tasks",
    "POST /api/tasks", "GET /api/tasks/{task_id}", "POST /api/tasks/{task_id}/comments",
    "PATCH /api/tasks/{task_id}/done"
  ],
  "pages": [],
  "critical_workflows": [],
  "sandbox": {"services": ["postgres"], "migrate": true, "seed": true},
  "run": {"cmd": ["{python}", "-m", "uvicorn", "app.main:app", "--port", "{port}", "--log-level", "warning"],
          "health": "/health", "requires_database": true},
  "defects": {
    "missing_index": {"finding": "slo_breach", "files": ["alembic/versions/0002_assignee_index.py"], "mechanism": "sequential scan on tasks.assignee_email"},
    "n_plus_one": {"finding": "regression", "files": ["app/routes.py"], "mechanism": "one comment-count query per task"},
    "pool_exhaustion": {"finding": "saturation", "files": ["app/routes.py", "app/db.py"], "mechanism": "connection held across slow call with pool_size=2"}
  }
}
